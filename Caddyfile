:81 {
	# Port Whitelist Map — only allow specific internal ports via XTransformPort
	map {query.XTransformPort} {target_port} {
		3000  "3000"
		3002  "3002"
		3003  "3003"
		3099  "3099"
		default ""
	}

	# Default Backend (no XTransformPort or invalid port)
	@default_target expression {target_port} == ""
	handle @default_target {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Transform-Port ""
			header_up X-Forwarded-Port ""
		}
	}

	# Whitelisted Port Routes
	handle {
		reverse_proxy localhost:{target_port} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Transform-Port ""
			header_up X-Forwarded-Port ""
		}
	}

	# Security Headers
	header {
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		X-XSS-Protection "0"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
	}
}
